# OpenAI API key — used by ai/aiClient.ts for GPT-4o + Whisper.
# Without this set, the app falls back to a stub client that returns mock data.
#
# Variables prefixed with EXPO_PUBLIC_ are bundled into the JS at build time.
# This is fine for personal/dev use, but BEFORE shipping publicly, move the key
# behind a tiny backend proxy (Vercel / Cloudflare Worker) to avoid leaking it.
EXPO_PUBLIC_OPENAI_API_KEY=
