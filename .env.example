# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and publishable key from the Supabase dashboard
# (Settings → API). The publishable key is public by design — Row Level
# Security protects the data, so this can safely ship in the client bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── One-off tooling (scripts/import-macro-foods.ts) ─────────────────────────
# Only needed to (re)seed the macro_proteins/macro_carbs/macro_fats tables from
# USDA FoodData Central via `npm run import:macro-foods`. NOT bundled into the
# app — used only by the local Node script. Leave blank unless running the import.
#
# USDA_API_KEY: a standard key from https://api.data.gov/signup (not DEMO_KEY).
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Settings → API → service_role secret.
#   This bypasses Row Level Security, so keep it server-side/local ONLY — never
#   commit a real value and never expose it in the client bundle.
USDA_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GEMINI_API_KEY: only needed to run the one-off familiarity scorer
# (scripts/score-macro-familiarity.ts via `npm run score:macro-familiarity`),
# which calls Gemini directly to score each macro food's everyday familiarity.
# Same key that's stored as the Supabase Edge Function secret — the app itself
# never reads this; it's used only by the local Node script. Leave blank unless
# running that script.
GEMINI_API_KEY=

# ─── RevenueCat ───────────────────────────────────────────────────────────────
# Public SDK key from the RevenueCat dashboard (Project settings → API keys).
# Safe to ship in the client bundle — entitlement is enforced server-side by
# RevenueCat/the App Store, not by keeping this key secret.
# Use a Test Store key during development to exercise purchases end-to-end
# without waiting on App Store review; swap to the production key later by
# changing only this line. Shared across iOS + Android until a separate
# Google Play Console setup exists.
EXPO_PUBLIC_REVENUECAT_API_KEY=
